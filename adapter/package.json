{
  "name": "@dsh-capsule/adapter",
  "version": "0.1.0",
  "description": "DSH Capability Guard: short-lived authorization leases, do-not-disturb windows and local authorization decisions for DeepSeek Harness",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whDonline/dsh-capsule.git",
    "directory": "adapter"
  },
  "homepage": "https://github.com/whDonline/dsh-capsule#readme",
  "bugs": {
    "url": "https://github.com/whDonline/dsh-capsule/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "approval",
    "authorization",
    "permissions",
    "sandbox"
  ],
  "engines": {
    "dsh": ">=0.1.5-0 <0.3.0",
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "disclosure": {
    "cloud": false,
    "network": [],
    "offlineMode": true,
    "apiKeys": [],
    "jurisdiction": [
      "CN"
    ],
    "retention": "local"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@types/node": "^22",
    "typescript": "^5.6",
    "vitest": "^2.1"
  }
}
